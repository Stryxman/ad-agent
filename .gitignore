.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.env

# Runs générés et assets produit (peuvent être lourds ou privés)
outputs/*
!outputs/.gitkeep
assets/products/*
!assets/products/.gitkeep
assets/.cache/
# Polices de marque (souvent sous licence) : jamais versionnées
assets/fonts/*
!assets/fonts/.gitkeep

# Ne jamais versionner les visuels de concurrents (droits d'auteur)
formats/references/

# Config locale des outils
.claude/
